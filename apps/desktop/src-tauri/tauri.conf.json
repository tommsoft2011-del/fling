{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 680,
        "minHeight": 520,
        "minWidth": 720,
        "title": "Fling Rust Data Plane POC (EXPERIMENTAL)",
        "width": 920
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "app.fling.desktop.rust-poc",
  "productName": "Fling Rust Data Plane POC (EXPERIMENTAL)",
  "version": "0.6.3"
}
